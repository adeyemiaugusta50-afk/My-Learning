{
  "name": "casual-chess-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser version of the Casual Chess Android app: two players on one device, full legal-move validation (chess.js), board rotation, autosave.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "gen:pieces": "node tools/gen-pieces.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
