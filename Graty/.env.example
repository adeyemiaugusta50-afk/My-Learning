# Copy this file to .env for local development and fill in your own values.
# Do not commit .env or paste service-account credentials into chat.
OFFICE_TIMEZONE=Africa/Lagos
GOOGLE_SHEET_ID=replace-with-the-id-from-the-sheet-url
GOOGLE_SHEET_TAB=Attendance
# Prefer storing the key file outside the repository and setting its absolute path:
GOOGLE_SERVICE_ACCOUNT_FILE=
# Alternatively, set GOOGLE_SERVICE_ACCOUNT_JSON to the complete one-line JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional; used by the Python logger.
LOG_LEVEL=INFO
